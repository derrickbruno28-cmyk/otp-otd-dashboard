rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@ghlogisticsllc[.]com');
    }
    function isOps() {
      return signedIn()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role
             in ['ops', 'manager', 'admin'];
    }
    // Tender PDFs only. An upload must correspond to a tenders doc the SAME ops user
    // just created (status "uploaded") — this closes the two tamper paths: a viewer
    // uploading arbitrary PDFs that burn model calls, and re-uploading a different
    // document to a confirmed tender's freed path after retention stripping.
    // Deletes are function-only (retention switch), so evidence can't quietly disappear.
    match /tenders/{tenderId} {
      allow read: if signedIn();
      allow create: if isOps()
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType == 'application/pdf'
        && firestore.get(/databases/(default)/documents/tenders/$(tenderId)).data.uploadedBy
             == request.auth.uid
        && firestore.get(/databases/(default)/documents/tenders/$(tenderId)).data.status
             == 'uploaded';
      allow update, delete: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
