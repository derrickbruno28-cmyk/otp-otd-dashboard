rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@ghlogisticsllc[.]com');
    }
    // Tender PDFs only. Uploads capped at 20MB and must be PDFs; deletes are
    // function-only (retention switch), so evidence can't quietly disappear.
    match /tenders/{tenderId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow update, delete: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
